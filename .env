# ==============================================================================
# Local relay-test configuration
# ==============================================================================
# This file configures BOTH:
#   - capture_control_center/app.py   (the GUI runs in MODE=relay)
#   - live_server/live_server.py      (the relay falls back to this file when
#                                      live_server/.env is absent)
# Test credentials: username = admin, password = testpass123
# ------------------------------------------------------------------------------

# ---------- GUI ----------
MODE=tunnel

# Direct mode listener (unused while MODE=relay).
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765

# GUI -> relay connection.
RELAY_URL=ws://127.0.0.1:8765

# Prefilled in the login dialog.
RELAY_USERNAME=admin

# Logical session bucket. Extension MUST use the same value.
SESSION_ID=default

# ---------- Relay server (live_server.py) ----------
# bcrypt hash of "testpass123" -- regenerate with:
#   python live_server/live_server.py hash-password '<your password>'
RELAY_PASSWORD_HASH=$2b$12$f0wuA2ODszgc7zBDfBHefeE4B2sQVJD6flhyygkDvvmdY0o/UJXVy

RELAY_HOST=127.0.0.1
RELAY_PORT=8765

# Allow plaintext ws:// -- only for local testing.
RELAY_ALLOW_PLAIN_WS=1

# ==============================================================================
# Relay server (live_server.py) configuration
# ==============================================================================
# Required:
#   RELAY_USERNAME       — operator username (matched constant-time)
#   RELAY_PASSWORD_HASH  — bcrypt hash. Generate with:
#                            python live_server.py hash-password 'mypassword'
#
# Optional:
RELAY_HOST=0.0.0.0
RELAY_PORT=8765
SESSION_ID=default

# Allow plaintext ws:// connections. ALWAYS keep this 0 in production behind a
# TLS-terminating reverse proxy (Caddy/Nginx). 1 is for local docker-compose only.
RELAY_ALLOW_PLAIN_WS=1

# ---- Replace these values ----
RELAY_USERNAME=admin
RELAY_PASSWORD_HASH=

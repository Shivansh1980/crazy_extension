# Local mode is the simplest setup. The GUI listens on this address and every
# client keeps reconnecting until it becomes available.
MODE=direct
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765
SESSION_ID=default

# Optional endpoint resolver overrides used by extension/native auto mode.
WEBSOCKET_RESOLVER_URL=https://pastebin.com/raw/pmrhGPW5
WEBSOCKET_SECONDARY_RESOLVER_URL=https://raw.githubusercontent.com/Shivansh1980/crazy_extension/refs/heads/main/server_url.txt

# Relay mode: set MODE=relay, configure the URL, and provide the username.
# The GUI asks for the password interactively and never stores it here.
RELAY_URL=
RELAY_USERNAME=

# Optional native-agent-only overrides.
# NATIVE_CONNECTION_MODE=auto
# NATIVE_BRIDGE_URL=ws://127.0.0.1:8765
